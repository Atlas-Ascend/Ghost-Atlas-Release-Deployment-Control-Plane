{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostatlas.local/schemas/estate-event-envelope.schema.json",
  "title": "Ghost Atlas Estate Event Envelope",
  "type": "object",
  "required": ["eventId", "eventType", "source", "occurredAt", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "pattern": "^GA-EVT-" },
    "eventType": { "type": "string", "minLength": 1 },
    "source": { "const": "ghost-atlas-release-deployment-control-plane" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1 },
    "releaseId": { "type": "string" },
    "deploymentId": { "type": "string" },
    "payload": {}
  },
  "additionalProperties": false
}
